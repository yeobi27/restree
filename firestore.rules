// 최종 수정: 2026-10-12
//
// RESTREE Firestore 보안 규칙 (초안 — 설계서 v1.3 §5, v1.4 §4.3, v1.5 §3 기준)
// 적용 방법: Firebase 콘솔 > Firestore Database > '규칙' 탭에 전체를 붙여넣고 '게시'.
//
// 원칙
//  - 모든 사용자 데이터는 본인(uid 일치)만 접근한다.
//  - records.keywords 는 AI(서버)만 채운다 → 클라이언트는 수정할 수 없다.
//  - 삭제는 소프트 삭제(deletedAt 기록)만 허용하고, 영구 삭제는 서버(Admin SDK) 전용이다.
//  - treeState / statsPeriodic / 재화·상점 컬렉션은 서버만 쓴다 (클라이언트는 읽기만).
//
// 참고: 글자수 상한(sceneText 등)은 앱의 제한(500/500/30자)보다 일부러 넉넉하게 잡았다.
//       서버 쪽은 남용 방지용이며, 정확한 제한은 앱 화면(AppLimits)이 맡는다.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // 기존 문서가 소프트 삭제 상태가 아닌가?
    function isLive() {
      return resource.data.get('deletedAt', null) == null;
    }

    // 기록 문서의 모양·값 검증 (생성/수정 공통)
    function validRecord(date) {
      let d = request.resource.data;
      return date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && d.date == date
        && d.emotion in ['good', 'comfortable', 'normal', 'tired', 'hard']
        && d.sceneText is string && d.sceneText.size() <= 1000
        && d.gratitudeText is string && d.gratitudeText.size() <= 1000
        && d.messageToSelf is string && d.messageToSelf.size() <= 100
        && d.imageUrls is list && d.imageUrls.size() <= 10
        && d.keywords is list
        && d.isFavorite is bool;
    }

    match /users/{uid} {

      match /records/{date} {
        allow read: if isOwner(uid);

        // 새 기록 — keywords는 비어 있어야 한다(서버가 채움).
        allow create: if isOwner(uid)
          && validRecord(date)
          && request.resource.data.keywords.size() == 0
          && request.resource.data.isFavorite == false
          && request.resource.data.get('deletedAt', null) == null;

        allow update: if isOwner(uid) && validRecord(date) && (
          // (a) 살아있는 기록의 수정 / 즐겨찾기 토글 / 소프트 삭제.
          //     서버 소유 필드(keywords, createdAt, date)는 변경할 수 없다.
          (isLive()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['emotion', 'sceneText', 'gratitudeText', 'messageToSelf',
                           'imageUrls', 'leafType', 'updatedAt', 'isFavorite', 'deletedAt']))
          ||
          // (b) 소프트 삭제된 날짜에 다시 쓰기 — 새 기록으로 덮어쓰며 deletedAt을 비운다 (결정 사항).
          (!isLive()
            && request.resource.data.get('deletedAt', null) == null
            && request.resource.data.keywords.size() == 0
            && request.resource.data.isFavorite == false)
        );

        // 영구 삭제는 서버(Admin SDK)만 — 클라이언트 직접 삭제 금지.
        allow delete: if false;
      }

      // 서버(Cloud Functions)가 계산해 쓰는 문서들 — 클라이언트는 읽기만.
      match /treeState/{docId}       { allow read: if isOwner(uid); allow write: if false; }
      match /statsPeriodic/{key}     { allow read: if isOwner(uid); allow write: if false; }

      // 상점·재화 (설계서 v1.3) — 잔액/구매 내역은 위·변조 방지를 위해 서버 전용 쓰기.
      match /wallet/{docId}          { allow read: if isOwner(uid); allow write: if false; }
      match /inventory/{itemId}      { allow read: if isOwner(uid); allow write: if false; }
      match /walletTransactions/{id} { allow read: if isOwner(uid); allow write: if false; }
      // TODO: 보유한 아이템 중에서만 장착할 수 있도록 검증을 넣어 클라이언트 쓰기를 열지,
      //       Functions로 처리할지 상점 구현 때 결정.
      match /equippedItems/{docId}   { allow read: if isOwner(uid); allow write: if false; }
    }

    // 상점 카탈로그 — 로그인한 사용자는 읽기만, 등록/수정은 관리자 전용(콘솔·Admin SDK).
    match /shopCatalog/{itemId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
